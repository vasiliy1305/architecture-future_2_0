@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

Person(user, "Customer / Employee", "Uses company digital services")

System_Boundary(system, "Future 2.0") {
  Container(web, "Web/Mobile Clients", "Web, Mobile", "User interface")
  Container(api, "API Gateway / BFF", "Gateway", "Single entry point for clients")
  Container(auth, "Auth Service", "Service", "Authentication and authorization")
  Container(profile, "Customer/Profile Service", "Service", "Customer data and profiles")
  Container(product, "Product/Catalog Service", "Service", "Products and business offerings")
  Container(order, "Order Service", "Service", "Orders and business operations")
  Container(payment, "Payment Service", "Service", "Payment processing")
  Container(notification, "Notification Service", "Service", "Email, SMS, push notifications")

  Container(eventbus, "Event Bus", "Kafka / RabbitMQ", "Asynchronous integration")
  ContainerDb(operationaldb, "Operational DB", "PostgreSQL", "Transactional data")

  Container(integration, "Data Integration Layer", "ETL / ELT / CDC / APIs / ACL", "Migration and integration layer: batch and incremental loads, API integrations, validation, transformations, mapping, anti-corruption adapters")
  ContainerDb(dwh, "Lakehouse Platform", "Object Storage + Query Engine", "Target analytical platform for domain data products, self-service BI, batch and near-real-time analytics")
  Container(legacy_esb, "Legacy ESB (Apache Camel)", "ESB", "Legacy routing, transformations, validation and synchronous integrations; used as compatibility bridge during migration")
  ContainerDb(legacy_dwh, "Legacy DWH (SQL Server 2008)", "SQL Server 2008", "Legacy enterprise warehouse in read-only / temporary mode; source of historical data and temporary reporting during migration")

}

Rel(user, web, "Uses")
Rel(web, api, "Calls")
Rel(api, auth, "Authenticates via")
Rel(api, profile, "Reads/writes profile")
Rel(api, product, "Reads catalog")
Rel(api, order, "Creates and tracks orders")
Rel(api, payment, "Initiates payments")
Rel(api, notification, "Triggers notifications")

Rel(order, operationaldb, "Reads/writes")
Rel(profile, operationaldb, "Reads/writes")
Rel(product, operationaldb, "Reads/writes")
Rel(payment, operationaldb, "Reads/writes")

Rel(order, eventbus, "Publishes events")
Rel(payment, eventbus, "Publishes events")
Rel(notification, eventbus, "Consumes events")
Rel(integration, eventbus, "Publishes/consumes events")


Rel(integration, dwh, "Loads batch and streaming data products")
Rel(legacy_esb, integration, "Passes legacy integrations, mappings and validation during transition")
Rel(legacy_dwh, integration, "Provides historical data and CDC extracts")
Rel(legacy_esb, eventbus, "Publishes limited domain events during migration")

@enduml